        print("\\n" + "─"*W)
        print(f" [{name:<31}] | Вес: {weight:<5.1f} | Pressure: {pressure:.2f} | Trust: {trust:.2f}")
        print(f"   ИСХОДНЫЙ  ROOT:{source[:2]} JILS:{source[2:4]} TAIL:{source[4:]} ")
        print(f"   БЕЗ       ROOT:{direct[:2]} JILS:{direct[2:4]} TAIL:{direct[4:]} | EURO:{de}")
        print(f"   С         ROOT:{chiral[:2]} JILS:{chiral[2:4]} TAIL:{chiral[4:]} | EURO:{ce}")
        print(f"   ОБЩИЕ MAIN:{common} | ОБЩИЕ EURO:{sorted(set(de)&set(ce))}")
        records.append({"id":idx,"name":name,"source":source,"without":{"main":direct,"euro":de},"with":{"main":chiral,"euro":ce},"trust":trust})
'''

new = '''        # ПОЛНЫЙ ВЕКТОРНЫЙ ИНТЕРФЕЙС V2

        common_main = sorted(
            set(direct)
            & set(chiral)
        )

        common_euro = sorted(
            set(de)
            & set(ce)
        )

        added_main = sorted(
            set(chiral)
            - set(direct)
        )

        removed_main = sorted(
            set(direct)
            - set(chiral)
        )

        added_euro = sorted(
            set(ce)
            - set(de)
        )

        removed_euro = sorted(
            set(de)
            - set(ce)
        )

        direct_zone_scores = {}

        chiral_zone_scores = {}

        for zone_name, positions in {
            "ROOT": (0, 1),
            "JILS": (2, 3),
            "TAIL": (4,),
        }.items():

            direct_field = main_scores(
                source,
                zone_name,
                data,
                reflected=False,
            )

            chiral_field = main_scores(
                source,
                zone_name,
                data,
                reflected=True,
            )

            direct_values = [
                direct_field[
                    direct[position]
                ]
                for position in positions
            ]

            chiral_values = [
                chiral_field[
                    chiral[position]
                ]
                for position in positions
            ]

            direct_zone_scores[zone_name] = (
                sum(direct_values)
                / len(direct_values)
            )

            chiral_zone_scores[zone_name] = (
                sum(chiral_values)
                / len(chiral_values)
            )

        direct_euro_field = euro_scores(
            direct,
            data,
            idx,
            reflected=False,
        )

        chiral_euro_field = euro_scores(
            chiral,
            data,
            idx,
            reflected=True,
        )

        direct_euro_score = sum(
            direct_euro_field[number]
            for number in de
        ) / len(de)

        chiral_euro_score = sum(
            chiral_euro_field[number]
            for number in ce
        ) / len(ce)

        print()
        print("─" * W)

        print(
            f" [{name:<31}] "
            f"| Вес: {weight:<5.1f} "
            f"| Pressure: {pressure:.2f} "
            f"| Trust: {trust:.2f}"
        )

        print(
            "   ИСХОДНЫЙ MAIN           : "
            f"{source}"
        )

        print(
            "   ИСХОДНЫЕ ЗОНЫ          : "
            f"ROOT={source[:2]} | "
            f"JILS={source[2:4]} | "
            f"TAIL={source[4:]}"
        )

        print()
        print("   🔵 БЕЗ ХИРАЛЬНОСТИ")

        print(
            "      MAIN                : "
            f"{direct}"
        )

        print(
            "      ROOT                : "
            f"{direct[:2]} "
            f"| TubeScore="
            f"{direct_zone_scores['ROOT']:.6f}"
        )

        print(
            "      JILS                : "
            f"{direct[2:4]} "
            f"| TubeScore="
            f"{direct_zone_scores['JILS']:.6f}"
        )

        print(
            "      TAIL                : "
            f"{direct[4:]} "
            f"| TubeScore="
            f"{direct_zone_scores['TAIL']:.6f}"
        )

        print(
            "      EURO                : "
            f"{de} "
            f"| EuroScore="
            f"{direct_euro_score:.6f}"
        )

        print(
            "      КОНТУР              : "
            "BOUNDED_TOROIDAL"
        )

        print(
            "      ОРИЕНТАЦИЯ          : "
            "DIRECT"
        )

        print(
            "      СОСТОЯНИЕ           : "
            "FINITE / NORMALIZED"
        )

        print()
        print("   🟣 С ХИРАЛЬНОСТЬЮ")

        print(
            "      MAIN                : "
            f"{chiral}"
        )

        print(
            "      ROOT                : "
            f"{chiral[:2]} "
            f"| TubeScore="
            f"{chiral_zone_scores['ROOT']:.6f}"
        )

        print(
            "      JILS                : "
            f"{chiral[2:4]} "
            f"| TubeScore="
            f"{chiral_zone_scores['JILS']:.6f}"
        )

        print(
            "      TAIL                : "
            f"{chiral[4:]} "
            f"| TubeScore="
            f"{chiral_zone_scores['TAIL']:.6f}"
        )

        print(
            "      EURO                : "
            f"{ce} "
            f"| EuroScore="
            f"{chiral_euro_score:.6f}"
        )

        print(
            "      КОНТУР              : "
            "BOUNDED_TOROIDAL"
        )

        print(
            "      ОРИЕНТАЦИЯ          : "
            "REFLECTED / CHIRAL"
        )

        print(
            "      СОСТОЯНИЕ           : "
            "FINITE / NORMALIZED"
        )

        print()
        print("   🤝 ОБЩЕЕ")

        print(
            "      MAIN                : "
            f"{common_main}"
        )

        print(
            "      EURO                : "
            f"{common_euro}"
        )

        print()
        print("   🪞 ХИРАЛЬНАЯ Δ")

        print(
            "      MAIN +ВОШЛИ         : "
            f"{added_main}"
        )

        print(
            "      MAIN -ВЫШЛИ         : "
            f"{removed_main}"
        )

        print(
            "      MAIN =ОБЩИЕ         : "
            f"{common_main}"
        )

        print(
            "      EURO +ВОШЛИ         : "
            f"{added_euro}"
        )

        print(
            "      EURO -ВЫШЛИ         : "
            f"{removed_euro}"
        )

        print(
            "      EURO =ОБЩИЕ         : "
            f"{common_euro}"
        )

        records.append({
            "id": idx,
            "name": name,
            "weight": weight,
            "pressure": pressure,
            "trust": trust,

            "source": {
                "main": source,
                "root": source[:2],
                "jils": source[2:4],
                "tail": source[4:],
            },

            "without_chirality": {
                "main": direct,
                "root": direct[:2],
                "jils": direct[2:4],
                "tail": direct[4:],
                "euro": de,
                "tube_scores": direct_zone_scores,
                "euro_score": direct_euro_score,
                "geometry": "bounded_toroidal",
                "orientation": "direct",
                "state": "finite_normalized",
            },

            "with_chirality": {
                "main": chiral,
                "root": chiral[:2],
                "jils": chiral[2:4],
                "tail": chiral[4:],
                "euro": ce,
                "tube_scores": chiral_zone_scores,
                "euro_score": chiral_euro_score,
                "geometry": "bounded_toroidal",
                "orientation": "reflected_chiral",
                "state": "finite_normalized",
            },

            "common": {
                "main": common_main,
                "euro": common_euro,
            },

            "delta": {
                "main_added": added_main,
                "main_removed": removed_main,
                "main_common": common_main,
                "euro_added": added_euro,
                "euro_removed": removed_euro,
                "euro_common": common_euro,
            },
        })
'''

if old not in source:
    raise SystemExit(
        "[ERROR] Не найден старый блок вывода V1-V18. "
        "Восстанови файл из резервной копии или проверь версию."
    )

