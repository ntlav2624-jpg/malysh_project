def relative_error(predicted, actual):
    numerator = sum(
        (p - a) ** 2
        for p, a in zip(predicted, actual)
    ) ** 0.5

    denominator = (
        sum(a * a for a in actual) ** 0.5
        + 1e-30
    )

    return numerator / denominator

