        )
    )

    candidate["flux_peak_value"] = float(
        candidate["flux"][
            candidate["flux_peak_shell"]
        ]
    )

    weighted = [
        (index ** 4) * value
        for index, value
        in enumerate(candidate["energy"])
    ]

    candidate["k4_peak_shell"] = int(
        max(
            range(len(weighted)),
            key=lambda i: weighted[i],
        )
    )

