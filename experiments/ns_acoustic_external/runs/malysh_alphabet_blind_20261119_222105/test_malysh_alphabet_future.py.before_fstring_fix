    f'{100.0 * reveal_packet["comparison"]["flux_improvement_fraction"]:.6f}%',
)
print()
print(
    "Actual flux peak shell:",
    actual_flux_peak,
)
print(
    "Actual flux peak value:",
    f'{actual["flux_peak_value"]:.12e}',
)
print(
